{
  "name": "thimbledb",
  "version": "2.0.0",
  "description": "Browser-oriented encrypted object-storage database with Node and Cloudflare authorities.",
  "private": false,
  "license": "Apache-2.0",
  "author": "Jason Doyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Doyle/thimble.git"
  },
  "homepage": "https://github.com/Jason-Doyle/thimble#readme",
  "bugs": {
    "url": "https://github.com/Jason-Doyle/thimble/issues"
  },
  "keywords": [
    "cloudflare",
    "r2",
    "database",
    "indexeddb",
    "object-storage",
    "encryption"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/package",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "public/thimbledb-logo.png",
    "docs/QUICKSTART.md",
    "docs/IMPLEMENTATION-PROMPTS.md",
    "docs/NPM-PUBLISHING.md",
    "docs/USE-CASES.md",
    "docs/use-cases",
    "docs/ADAPTIVE-LAYOUTS.md",
    "docs/AUTHENTICATION.md",
    "docs/DELETION-RETENTION.md",
    "docs/PUBLIC-API.md",
    "docs/PROTOCOL.md",
    "docs/VERSIONING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./auth": {
      "types": "./dist/package/auth/index.d.ts",
      "import": "./dist/package/auth/index.js"
    },
    "./authority/node": {
      "types": "./dist/package/authority/node.d.ts",
      "import": "./dist/package/authority/node.js"
    },
    "./authority/cloudflare": {
      "types": "./dist/package/authority/cloudflare.d.ts",
      "import": "./dist/package/authority/cloudflare.js"
    },
    "./providers/local": {
      "types": "./dist/package/providers/local.d.ts",
      "import": "./dist/package/providers/local.js"
    },
    "./providers/azure": {
      "types": "./dist/package/providers/azure.d.ts",
      "import": "./dist/package/providers/azure.js"
    },
    "./providers/s3": {
      "types": "./dist/package/providers/s3.d.ts",
      "import": "./dist/package/providers/s3.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run start:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server.ts",
    "build": "npm run build:client && npm run build:package && npm run build:server && npm run build:worker",
    "build:client": "vite build",
    "build:package": "node -e \"require('node:fs').rmSync('dist/package',{recursive:true,force:true})\" && tsc -p tsconfig.package.json",
    "build:server": "node -e \"require('node:fs').rmSync('dist/server',{recursive:true,force:true})\" && tsc -p tsconfig.server.json",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker src/cloudflare-worker.ts --name thimbledb-worker --compatibility-date 2026-09-01",
    "start:server": "tsx src/server.ts",
    "start:prod": "node dist/server/server.js",
    "benchmark": "tsx src/cli.ts",
    "benchmark:local": "tsx src/cli.ts --provider local --profile tiny --latency-ms 8",
    "benchmark:azure": "tsx src/cli.ts --provider azure --profile tiny",
    "benchmark:s3": "tsx src/cli.ts --provider s3 --profile tiny",
    "migrate:keys": "tsx src/key-migrate.ts",
    "migrate:external-auth": "tsx src/remove-local-auth.ts",
    "advise:layout": "tsx src/layout-advisor-cli.ts",
    "migrate:layout": "tsx src/layout-migrate.ts",
    "maintain:retention": "tsx src/retention-maintain.ts",
    "fixtures:generate": "tsx scripts/generate-protocol-fixtures.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:check": "npm --prefix site run check",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:test": "npm --prefix site run test:worker && playwright test --config site/playwright.config.ts",
    "site:deploy:check": "wrangler deploy --cwd site --config wrangler.jsonc --dry-run",
    "site:deploy": "wrangler deploy --cwd site --config wrangler.jsonc",
    "site:validate:production": "npm --prefix site run validate:production",
    "examples:check": "npm --prefix examples/local-notes test && npm --prefix examples/cloudflare-notes run check"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@azure/storage-blob": "^12.28.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@azure/storage-blob": "^12.28.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22"
  }
}
