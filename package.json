{
  "name": "thimbledb",
  "version": "3.1.0",
  "description": "Encrypted browser-first JSON database for small web apps, backed by object storage with in-app or separate Cloudflare and Node authorities.",
  "private": false,
  "license": "Apache-2.0",
  "author": "Jason Doyle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Doyle/thimble.git"
  },
  "homepage": "https://thimbledb.com",
  "bugs": {
    "url": "https://github.com/Jason-Doyle/thimble/issues"
  },
  "keywords": [
    "cloudflare",
    "cloudflare-r2",
    "cloudflare-workers",
    "r2",
    "database",
    "database-admin",
    "browser-database",
    "json-database",
    "indexeddb",
    "object-storage",
    "encryption",
    "oidc",
    "aws-s3",
    "azure-blob-storage",
    "serverless",
    "typescript",
    "webcrypto",
    "vibe-coding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "thimbledb": "bin/thimbledb.mjs"
  },
  "sideEffects": false,
  "files": [
    "dist/package",
    "dist/studio",
    "bin",
    "scripts/generate-entra-roles.mjs",
    "scripts/generate-entra-roles.d.mts",
    "templates/local-web",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "public/thimbledb-logo.png",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./auth": {
      "types": "./dist/package/auth/index.d.ts",
      "import": "./dist/package/auth/index.js"
    },
    "./authority/node": {
      "types": "./dist/package/authority/node.d.ts",
      "import": "./dist/package/authority/node.js"
    },
    "./authority/cloudflare": {
      "types": "./dist/package/authority/cloudflare.d.ts",
      "import": "./dist/package/authority/cloudflare.js"
    },
    "./providers/local": {
      "types": "./dist/package/providers/local.d.ts",
      "import": "./dist/package/providers/local.js"
    },
    "./providers/azure": {
      "types": "./dist/package/providers/azure.d.ts",
      "import": "./dist/package/providers/azure.js"
    },
    "./providers/s3": {
      "types": "./dist/package/providers/s3.d.ts",
      "import": "./dist/package/providers/s3.js"
    },
    "./migration": {
      "types": "./dist/package/migration/index.d.ts",
      "import": "./dist/package/migration/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "npm run build:studio && concurrently -k -n server,client \"npm run start:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:studio": "vite --config studio/vite.config.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "npm run build:client-assets && npm run build:package && npm run build:server && npm run build:worker",
    "build:client": "vite build",
    "build:client-assets": "npm run build:client && npm run build:studio && node bin/thimbledb.mjs studio-assets dist/browser/studio",
    "build:package": "npm run build:studio && node -e \"require('node:fs').rmSync('dist/package',{recursive:true,force:true})\" && tsc -p tsconfig.package.json",
    "build:studio": "vite build --config studio/vite.config.ts",
    "build:server": "node -e \"require('node:fs').rmSync('dist/server',{recursive:true,force:true})\" && tsc -p tsconfig.server.json",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker src/cloudflare-worker.ts --name thimbledb-worker --compatibility-date 2026-09-01",
    "start:server": "tsx src/server.ts",
    "start:prod": "node dist/server/server.js",
    "benchmark": "tsx src/cli.ts",
    "benchmark:local": "tsx src/cli.ts --provider local --profile tiny --latency-ms 8",
    "benchmark:azure": "tsx src/cli.ts --provider azure --profile tiny",
    "benchmark:s3": "tsx src/cli.ts --provider s3 --profile tiny",
    "benchmark:compare:local": "tsx benchmarks/comparative/run.mjs",
    "benchmark:indexed-segment": "tsx benchmarks/indexed-segment/run.mjs",
    "benchmark:indexed-segment:regional:generate": "tsx benchmarks/indexed-segment/regional/generate-data.mjs",
    "benchmark:indexed-segment:regional:build": "vite build --config benchmarks/indexed-segment/regional/vite.config.ts",
    "benchmark:indexed-segment:regional:aggregate": "node benchmarks/indexed-segment/regional/aggregate.mjs",
    "migrate:keys": "tsx src/key-migrate.ts",
    "migrate:external-auth": "tsx src/remove-local-auth.ts",
    "advise:layout": "tsx src/layout-advisor-cli.ts",
    "migrate:layout": "tsx src/layout-migrate.ts",
    "migrate:indexes": "tsx src/index-migrate.ts",
    "migrate:metadata": "tsx src/metadata-migrate.ts",
    "auth:roles:entra": "node scripts/generate-entra-roles.mjs",
    "maintain:retention": "tsx src/retention-maintain.ts",
    "fixtures:generate": "tsx scripts/generate-protocol-fixtures.ts",
    "check": "tsc --noEmit && tsc -p studio/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:scaffold": "node scripts/verify-scaffold.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:check": "npm --prefix site run check",
    "site:diagrams": "npm --prefix site run generate:diagrams",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "site:test": "npm --prefix site run test:worker && playwright test --config site/playwright.config.ts",
    "site:deploy:check": "wrangler deploy --cwd site --config wrangler.jsonc --dry-run",
    "site:deploy": "wrangler deploy --cwd site --config wrangler.jsonc",
    "site:validate:production": "npm --prefix site run validate:production",
    "examples:check": "npm --prefix examples/local-notes test && npm --prefix examples/cloudflare-notes run check"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "peerDependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@azure/storage-blob": "^12.28.0",
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "@google-cloud/firestore": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@azure/storage-blob": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@azure/storage-blob": "^12.28.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22"
  }
}
