{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://127.0.0.1:5173"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "If-None-Match"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
