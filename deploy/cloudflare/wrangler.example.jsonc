{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "thimbledb",
  "main": "../../src/cloudflare-worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "assets": {
    "directory": "../../dist/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "THIMBLE_PREFIX": "demo",
    "THIMBLE_KEY_VERSION": "1",
    "THIMBLE_READ_KEY_VERSIONS": "",
    "THIMBLE_HEAD_TTL_MS": "1000",
    "THIMBLE_COLLECTION_LAYOUTS": "",
    "THIMBLE_RETIRED_COLLECTION_LAYOUTS": "",
    "THIMBLE_DELETE_RETENTION_DAYS": "30",
    "THIMBLE_DELETE_GRACE_DAYS": "7",
    "THIMBLE_MAINTENANCE_MODE": "false",
    "THIMBLE_ALLOWED_ORIGIN": "https://db.example.com",
    // Optional Microsoft Entra configuration:
    // "ENTRA_TENANT_ID": "00000000-0000-0000-0000-000000000000",
    // "ENTRA_AUDIENCE": "api://your-application-id",
    // "ENTRA_REQUIRED_SCOPE": "thimble.access",
    // "ENTRA_REQUIRED_ROLE": "Thimble.User",
    // Optional generic OIDC configuration:
    // "OIDC_PROVIDER_ID": "auth0",
    // "OIDC_ISSUER": "https://tenant.example.com/",
    // "OIDC_AUDIENCE": "https://db.example.com",
    // "OIDC_JWKS_URI": "https://tenant.example.com/.well-known/jwks.json",
    // "OIDC_ALLOWED_TENANTS": "",
    // "OIDC_REQUIRED_SCOPE": "thimble.access",
    // "OIDC_REQUIRED_ROLE": ""
  },

  // Intentionally disabled. Copy this file to wrangler.jsonc, create the
  // bucket, then uncomment and set the real bucket name.
  //
  // "r2_buckets": [
  //   {
  //     "binding": "DB",
  //     "bucket_name": "your-real-data-bucket"
  //   },
  //   {
  //     "binding": "AUTH_DB",
  //     "bucket_name": "your-private-auth-bucket"
  //   }
  // ],
  //
  // Optional low-latency source-IP limiting. OIDC-subject limits remain in
  // the encrypted R2 auth store. Choose a namespace_id unique to this account.
  //
  // "ratelimits": [
  //   {
  //     "name": "AUTH_RATE_LIMITER",
  //     "namespace_id": "1001",
  //     "simple": {
  //       "limit": 5,
  //       "period": 60
  //     }
  //   }
  // ],
  //
  // Intentionally disabled. Add a real route only after application
  // authentication, secrets, and the exact allowed origin are configured.
  //
  // "routes": [
  //   {
  //     "pattern": "db.example.com",
  //     "custom_domain": true
  //   }
  // ]
}
