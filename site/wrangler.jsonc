{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "thimbledb-redirect",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "thimbledb.com",
      "custom_domain": true
    },
    {
      "pattern": "www.thimbledb.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
